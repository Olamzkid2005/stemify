{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemify.app/schemas/output-manifest.schema.json",
  "title": "Output manifest (manifest.json inside the result ZIP)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "source", "separation", "output"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "pattern": "^job_[A-Za-z0-9]{16,64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "durationSeconds", "sampleRate", "channels"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "sampleRate": { "enum": [22050, 24000, 32000, 44100, 48000] },
        "channels": { "enum": [1, 2] }
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "modelId", "modelRevision", "mixtureConsistency"],
      "properties": {
        "mode": { "$ref": "common.schema.json#/$defs/separationMode" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modelRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mixtureConsistency": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "stems"],
      "properties": {
        "format": { "$ref": "common.schema.json#/$defs/outputFormat" },
        "stems": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "durationSeconds", "sha256"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/stemKey" },
              "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
