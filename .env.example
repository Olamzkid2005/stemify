# Stemify environment template — names and descriptions only, never commit real values.
# Web app (apps/web) — see plan Section 17.1

# Postgres connection string (Supabase, transaction pooler - port 6543)
DATABASE_URL=

# Supabase project (client + SSR); public URL and publishable key are safe for the browser.
# The service role key is server-only. Never expose it through NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private object storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Worker integration
WORKER_LAUNCH_URL=
WORKER_LAUNCH_SECRET=
WORKER_CALLBACK_SECRET=

# Signing secrets for guest job access and presigned uploads
JOB_ACCESS_TOKEN_SECRET=
UPLOAD_SIGNING_SECRET=

# Product limits
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=480
JOB_RETENTION_HOURS=24
