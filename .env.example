# Stemify local environment template — names and descriptions only.
# Runtime data stays on this machine; no cloud credentials are required.

# Local paths
STEMIFY_DATA_DIR=./data
STEMIFY_LOG_DIR=./data/logs

# Local web server
PORT=3000
HOSTNAME=127.0.0.1

# Local processing
STEMIFY_DEVICE=auto
STEMIFY_MODEL_PROFILE=demucs_default
STEMIFY_MODEL_DIR=./data/models
STEMIFY_WORKER_POLL_MS=500
# How many jobs run at once (start.sh starts this many worker processes; 1
# restores strictly one-at-a-time). Each worker loads its own copy of the
# separation model, so raise it only with RAM to match — see worker/README.md
# for the arithmetic and docs/BENCHMARKS.md for the measured cost.
STEMIFY_WORKER_CONCURRENCY=2
# Threads each worker may use. start.sh defaults it to cores / concurrency, so
# the pool shares the CPU instead of every worker grabbing every core. Set it
# only to override that split.
# STEMIFY_WORKER_THREADS=

# Local session signing
JOB_ACCESS_TOKEN_SECRET=replace-with-a-long-random-local-value

# Optional link sources. start.sh exports this file to both the web app and the
# worker, so a value here is what both of them see (worker/README.md explains the
# one-time Premium login Spotify needs).
#
# YouTube input; the worker defaults this ON, so 0 switches it off.
STEMIFY_YOUTUBE_ENABLED=1
# Spotify input; the worker defaults this OFF. Leave it 0 until the one-time
# Premium login is done, or every Spotify job fails as soon as it is claimed.
STEMIFY_SPOTIFY_ENABLED=0
# Optional free Web API app. Not needed: the worker reads the title, artist,
# album and duration from the Premium session above and saves the cover locally,
# so jobs are named "Artist - Title" and show their album art out of the box.
# Setting it only names a job a few seconds earlier.
# STEMIFY_SPOTIFY_CLIENT_ID=
# STEMIFY_SPOTIFY_CLIENT_SECRET=

# Product limits
MAX_UPLOAD_BYTES=104857600
MAX_DURATION_SECONDS=480
MAX_FULL_STEMS_DURATION_SECONDS=360
JOB_RETENTION_HOURS=24
# How many queued+processing jobs one browser may have at once. The default is
# the worker pool (2) plus one waiting job: submitting while others run still
# queues, and this stays the backstop for a client that keeps submitting.
MAX_ACTIVE_JOBS=3
